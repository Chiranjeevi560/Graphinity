{
  "name": "@graphinity/api",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node --env-file=../../.local/api.env --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:local": "SUPABASE_URL=http://localhost:54321 SUPABASE_SECRET_KEY=dev_local_secret_0123456789 node --env-file=../../.local/api.env --watch src/main.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "fastify": "5.12.6",
    "jose": "6.2.12",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
