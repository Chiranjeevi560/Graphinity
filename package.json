{
  "name": "graphinity",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "db:start": "sh scripts/db.sh start",
    "db:stop": "sh scripts/db.sh stop",
    "db:apply": "sh scripts/db.sh apply",
    "db:migrate:remote": "node --env-file=.local/migrate.env apps/api/src/migrate-main.ts",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "typecheck": "npm --workspaces run typecheck && tsc -p apps/web/functions --noEmit && tsc -p apps/web/e2e --noEmit",
    "test": "npm --workspaces --if-present run test",
    "build": "npm --workspaces run build",
    "dev:auth": "DEV_AUTH_SECRET_KEY=dev_local_secret_0123456789 node scripts/dev-auth.mjs",
    "lint": "eslint .",
    "test:e2e": "playwright test --project=chromium --project=webkit",
    "test:coverage": "npm --workspaces run test -- --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.include=src/**",
    "check:secrets": ".local/tools/gitleaks git --redact --no-banner . && .local/tools/gitleaks git --pre-commit --redact --no-banner .",
    "check:deps": ".local/tools/osv-scanner scan source --lockfile package-lock.json && npm audit --audit-level=high",
    "check:licenses": ".local/tools/osv-scanner scan source --lockfile package-lock.json --licenses=MIT,Apache-2.0,ISC,MPL-2.0,BSD-3-Clause,BSD-2-Clause,0BSD,BlueOak-1.0.0,CC-BY-4.0,CC0-1.0,Python-2.0",
    "check:size": "size-limit",
    "check:perf": "node scripts/lighthouse.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:fast": "npm run typecheck && npm run lint && npm run format:check && node scripts/floor-guard.mjs && node scripts/check-migrations.mjs",
    "check:task": "npm run check:fast && npm run test:coverage && npm run build && npm run check:size",
    "check:full": "npm run check:task && npm run check:secrets && npm run check:deps && npm run check:licenses && npm run test:e2e && npm run check:perf",
    "dev:api:local": "npm --workspace apps/api run dev:local"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@size-limit/file": "14.2.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "lighthouse": "13.5.0",
    "prettier": "3.9.10",
    "size-limit": "14.2.0",
    "typescript-eslint": "8.71.2"
  },
  "size-limit": [
    {
      "name": "main script (brotli)",
      "path": "apps/web/dist/assets/index-*.js",
      "limit": "61.80 kB"
    },
    {
      "name": "styles (brotli)",
      "path": "apps/web/dist/assets/index-*.css",
      "limit": "6.37 kB"
    },
    {
      "name": "all scripts (brotli)",
      "path": "apps/web/dist/assets/*.js",
      "limit": "99.51 kB"
    }
  ],
  "overrides": {
    "chromium-bidi": {
      "zod": "4.6.6"
    }
  }
}
